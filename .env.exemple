# Copier ce fichier en .env et renseigner les valeurs.
# .env n'est jamais commite : il est dans .gitignore.

# Cle d'API du fournisseur de modele.
ANTHROPIC_API_KEY=

# Niveau de journalisation : DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# Politique de validation des outils sensibles :
#   refus     - refuse toute action sensible sans rien demander (defaut, et
#               seule valeur admise en evaluation)
#   console   - demande la validation en ligne de commande
APPROBATION=refus
